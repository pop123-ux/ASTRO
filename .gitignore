# Build and tool caches
.pytest_cache/
.ruff_cache/
*.egg-info/
__pycache__/
*.py[cod]

# Local/intermediate paper renders. The PDF is built from paper.tex and may be
# attached by CI; stale compiled binaries are not kept as source-of-truth.
docs/paper/paper.html

# Benchmark output. Note "artifacts/*", not "artifacts/": git does not descend
# into an ignored directory, so negations below remain effective.
artifacts/*
results/

# Evidence records are source material for the paper, not disposable output.
!artifacts/measured.json
!artifacts/paper_results.json
!artifacts/trajectories.json
